# Copia este archivo a .env y rellena tus credenciales. .env NO se sube a git.
# Cuenta gratis: https://urs.earthdata.nasa.gov/users/new

# Opción A (recomendada): token de Earthdata.
# Se genera en https://urs.earthdata.nasa.gov/profile -> "Generate Token" (dura 60 días).
EARTHDATA_TOKEN=

# Opción B: usuario y contraseña (se usan para pedir un token automáticamente).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# https = streaming por HTTP con rangos (funciona desde cualquier sitio).
# s3    = acceso S3 directo; SOLO funciona desde una máquina AWS en us-west-2.
SAR_ACCESS_MODE=https

# Área de interés por defecto: lon_min,lat_min,lon_max,lat_max (EPSG:4326).
# Este es el polígono de La Española de la búsqueda de ASF Vertex.
AOI_BBOX=-74.7289,17.4873,-68.1135,20.1331
