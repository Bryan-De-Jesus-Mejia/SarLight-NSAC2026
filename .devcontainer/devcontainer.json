{
  "name": "NISAR pipeline (DataAnalytics)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "secrets": {
    "EARTHDATA_USERNAME": {
      "description": "Usuario de NASA Earthdata Login (https://urs.earthdata.nasa.gov)"
    },
    "EARTHDATA_PASSWORD": {
      "description": "Contraseña de NASA Earthdata Login"
    }
  },
  "postCreateCommand": "pip install --no-cache-dir -r 'DataAnalytics/requirements.txt'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
